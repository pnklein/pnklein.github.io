{

_mtx translate _tm _tm concatmatrix pop iTm 0 0 moveto

} def



/Te	% end render					% - Te -

{

	_render -1 eq {} {_renderEnd _render get dup null ne {load exec} {pop} ifelse} ifelse

	/_render -1 ddef

} def





